BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

DATABASE_URL=

# Optional. Neon exposes a pooled and a direct endpoint; migrations must use
# the direct one. Leave empty to derive it from DATABASE_URL.
DIRECT_DATABASE_URL=

ARCJET_KEY=


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Google OAuth client id (same value as GOOGLE_CLIENT_ID). It is used by
# the native app to obtain a Google ID token that the server can verify.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SMTP Configuration for Nodemailer (replaced Postmark)
# You can use any SMTP provider like Gmail, SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST= # SMTP server hostname (e.g., smtp.gmail.com for Gmail)
SMTP_PORT= # SMTP port (587 for TLS, 465 for SSL, 25 for non-secure)
SMTP_SECURE= # Set to "true" for port 465 (SSL), "false" for port 587 (TLS)
SMTP_USER= # Your SMTP username (usually your email)
SMTP_PASS= # Your SMTP password or app-specific password
SMTP_FROM_EMAIL= # Email address to send emails from

# SMS reminders. "email-gateway" (default) delivers through the carrier's
# free email-to-SMS bridge using the SMTP account above. "textbee" relays to
# an Android gateway phone through TextBee, which can reach any number the
# phone's SIM can (including +63). "console" logs instead of sending.
SMS_PROVIDER=email-gateway

# TextBee - only read when SMS_PROVIDER=textbee. The URL is the full send
# endpoint, so a self-hosted instance can use its own domain.
TEXTBEE_API_KEY=
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/send-sms

CRON_SECRET=""
NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""